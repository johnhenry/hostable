{
  "name": "@johnhenry/hostable",
  "version": "0.0.0",
  "description": "Declaratively describe an API gateway using JSX -- routes across multiple domains/backends by Host header, on top of @johnhenry/servable's single-app dispatcher.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx-runtime.d.ts",
      "default": "./dist/src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/src/jsx-dev-runtime.d.ts",
      "default": "./dist/src/jsx-dev-runtime.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./adapters/deno": {
      "types": "./dist/adapters/deno.d.ts",
      "default": "./dist/adapters/deno.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "default": "./dist/adapters/bun.js"
    },
    "./adapters/cloudflare": {
      "types": "./dist/adapters/cloudflare.d.ts",
      "default": "./dist/adapters/cloudflare.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/hostable.git"
  },
  "homepage": "https://opensource.johnhenry.me/hostable/",
  "bugs": {
    "url": "https://github.com/johnhenry/hostable/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "files": [
    "dist/src",
    "dist/adapters",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test scripts/run-tests.mjs",
    "coverage": "node --test --experimental-test-coverage scripts/run-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jsx",
    "http",
    "gateway",
    "reverse-proxy",
    "multi-domain",
    "router"
  ],
  "author": "John Henry",
  "dependencies": {
    "@johnhenry/servable": "file:../servable",
    "urlpattern-polyfill": "^10.0.0"
  },
  "peerDependencies": {
    "@johnhenry/dialback": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/dialback": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/dialback": "^0.0.3",
    "@johnhenry/fileable": "^0.0.1",
    "@johnhenry/leserve": "^0.0.0",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "ws": "^8.18.0"
  }
}
